# Bash/Cloud Shell: copy to .env, fill values, then: set -a; source .env; set +a
# .env is ignored by Git. This file contains no credentials or live endpoints.
PROJECT_ID=""
REGION="us-east1"
GENAI_LOCATION="us"
ZONE="us-east1-b"
ADBCLUSTER="agent-memory-cluster"
ADBINSTANCE="agent-memory-instance"
VALKEYINSTANCE="agent-memory-cache"
VM_NAME="agent-dev-vm"

# Per-developer connection settings. DB_USER must match your IAM database user.
DB_HOST=""
DB_PORT="5432"
DB_NAME="postgres"
DB_USER=""
VALKEY_HOST=""
VALKEY_PORT="6379"

# ADK settings. Core tutorial modules retain their original model identifiers.
GEMINI_MODEL="gemini-3.5-flash"
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us"
